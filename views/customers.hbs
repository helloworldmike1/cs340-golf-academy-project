<h1>Customers</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
           <th>Customer ID</th>
           <th>First Name</th>
           <th>Last Name</th>
           <th>Email</th>
           <th>Phone Number</th>
           <th>Membership</th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the CustomerId, firstName, lastName, email, phone, & related membership}}
        {{#each customers}}
        <tr>
            <td>{{this.customerId}}</td>
            <td>{{this.firstName}}</td>
            <td>{{this.lastName}}</td>
            <td>{{this.email}}</td>
            <td>{{this.phone}}</td>
           <td>{{this.membership}}</td>

        </tr>
        {{/each}}
    </tbody>
</table>


{{! CREATE form }}
<h2>Create a Customer</h2>
<form class='cuForm' id='create_customer_form' method="POST" action="/create-customer">


    <label for='create_customer_firstName'>First Name: </label>
    <input type='text' name='create_customer_firstName' id='create_customer_firstName' required />

    <label for='create_customer_lastName'>Last Name: </label>
    <input type='text' name='create_customer_lastName' id='create_customer_lastName' required />

     <label for='create_customer_email'>Email: </label>
    <input type='email' name='create_customer_email' id='create_customer_email' required />

      <label for='create_customer_phone'>Phone: </label>
    <input type='tel' name='create_customer_phone' id='create_customer_phone' required />


    <label for=':membershipId_from_create_customer_membership_dropdown'>Membership: </label>
    <select name=':membershipId_from_create_customer_membership_dropdown' id=':membershipId_from_create_customer_membership_dropdown'>
        <option value="" selected>Select a Membership</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each memberships}}
        <option value='{{this.membershipId}}'>{{this.name}}</option>
        {{/each}}
    </select>

    <input type='submit' />
</form>
